function Library:CreateTab(name)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Name = name.."Tab"
    tabBtn.Size = UDim2.new(1, 0, 0, 36)
    tabBtn.BackgroundTransparency = 1
    tabBtn.Text = "   " .. name
    tabBtn.TextColor3 = self.Theme.TextDark
    tabBtn.Font = Enum.Font.GothamBold
    tabBtn.TextSize = 14
    tabBtn.TextXAlignment = Enum.TextXAlignment.Left
    tabBtn.Parent = self.TabList
    
    local indicator = Instance.new("Frame", tabBtn)
    indicator.Size = UDim2.new(0, 3, 0.6, 0)
    indicator.Position = UDim2.new(0, 0, 0.2, 0)
    indicator.BackgroundColor3 = self.Theme.Accent
    indicator.BorderSizePixel = 0
    indicator.BackgroundTransparency = 1

    local page = Instance.new("ScrollingFrame")
    page.Name = name.."Page"
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.ScrollBarThickness = 4
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.Visible = false
    page.Parent = self.PageContainer

    local padding = Instance.new("UIPadding", page)
    padding.PaddingTop = UDim.new(0, 4)
    padding.PaddingBottom = UDim.new(0, 4)
    padding.PaddingLeft = UDim.new(0, 4)
    padding.PaddingRight = UDim.new(0, 4)

    -- 2-Column manual layout instead of grid
    local leftColumn = Instance.new("Frame", page)
    leftColumn.Name = "LeftColumn"
    leftColumn.Size = UDim2.new(0.5, -5, 1, 0)
    leftColumn.Position = UDim2.new(0, 0, 0, 0)
    leftColumn.BackgroundTransparency = 1
    
    local leftList = Instance.new("UIListLayout", leftColumn)
    leftList.FillDirection = Enum.FillDirection.Vertical
    leftList.SortOrder = Enum.SortOrder.LayoutOrder
    leftList.Padding = UDim.new(0, 10)
    
    local rightColumn = Instance.new("Frame", page)
    rightColumn.Name = "RightColumn"
    rightColumn.Size = UDim2.new(0.5, -5, 1, 0)
    rightColumn.Position = UDim2.new(0.5, 5, 0, 0)
    rightColumn.BackgroundTransparency = 1
    
    local rightList = Instance.new("UIListLayout", rightColumn)
    rightList.FillDirection = Enum.FillDirection.Vertical
    rightList.SortOrder = Enum.SortOrder.LayoutOrder
    rightList.Padding = UDim.new(0, 10)
    
    -- Track which column to add to next
    local sectionColumn = "left"
    
    -- Update canvas size when either column changes
    local function updateCanvasSize()
        local leftHeight = leftList.AbsoluteContentSize.Y
        local rightHeight = rightList.AbsoluteContentSize.Y
        local maxHeight = math.max(leftHeight, rightHeight)
        page.CanvasSize = UDim2.new(0, 0, 0, maxHeight + 10)
    end
    
    leftList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvasSize)
    rightList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvasSize)

    local tabObj = {
        Button = tabBtn,
        Page = page,
        Unselected = function()
            tabBtn.TextColor3 = self.Theme.TextDark
            indicator.BackgroundTransparency = 1
            page.Visible = false
        end,
        Selected = function()
            tabBtn.TextColor3 = self.Theme.Accent
            indicator.BackgroundTransparency = 0
            page.Visible = true
        end
    }

    tabBtn.MouseButton1Click:Connect(function()
        if Library.ActiveTab then Library.ActiveTab.Unselected() end
        Library.ActiveTab = tabObj
        Library.ActiveTab.Selected()
    end)

    table.insert(self.Tabs, tabObj)
    if #self.Tabs == 1 then
        Library.ActiveTab = tabObj
        Library.ActiveTab.Selected()
    end

    function tabObj:CreateSection(titleText)
        -- Alternate between left and right columns
        local parentColumn = (sectionColumn == "left") and leftColumn or rightColumn
        sectionColumn = (sectionColumn == "left") and "right" or "left"
        
        local section = Instance.new("Frame")
        section.BackgroundColor3 = Color3.fromRGB(25, 30, 42)
        section.Size = UDim2.new(1, 0, 0, 100)  -- Initial height, will be adjusted
        section.Parent = parentColumn
        Instance.new("UICorner", section).CornerRadius = UDim.new(0, 6)
        
        local secStroke = Instance.new("UIStroke", section)
        secStroke.Color = Library.Theme.Accent
        secStroke.Thickness = 1
        
        -- Add padding so text doesn't touch the yellow border
        local secPadding = Instance.new("UIPadding", section)
        secPadding.PaddingLeft = UDim.new(0, 12)
        secPadding.PaddingRight = UDim.new(0, 12)
        secPadding.PaddingTop = UDim.new(0, 8)
        secPadding.PaddingBottom = UDim.new(0, 8)
        
        -- Yellow dot before title
        local dot = Instance.new("Frame", section)
        dot.Size = UDim2.new(0, 8, 0, 8)
        dot.Position = UDim2.new(0, 10, 0, 11)
        dot.BackgroundColor3 = Library.Theme.Accent
        dot.BorderSizePixel = 0
        local dotCorner = Instance.new("UICorner", dot)
        dotCorner.CornerRadius = UDim.new(1, 0) -- Fully circular
        
        local title = Instance.new("TextLabel", section)
        title.Size = UDim2.new(1, -40, 0, 30)
        title.Position = UDim2.new(0, 22, 0, 0) -- Offset to make room for dot
        title.BackgroundTransparency = 1
        title.Text = string.upper(titleText)
        title.TextColor3 = Library.Theme.Accent
        title.Font = Enum.Font.GothamBold
        title.TextSize = 12
        title.TextXAlignment = Enum.TextXAlignment.Left

        local container = Instance.new("Frame", section)
        container.Size = UDim2.new(1, 0, 1, -30)
        container.Position = UDim2.new(0, 0, 0, 30)
        container.BackgroundTransparency = 1
        
        local list = Instance.new("UIListLayout", container)
        list.SortOrder = Enum.SortOrder.LayoutOrder
        list.Padding = UDim.new(0, 5)

        local function updateSectionSize()
            -- Calculate only visible items
            local visibleHeight = 0
            for _, child in pairs(container:GetChildren()) do
                if not child:IsA("UIListLayout") and child.Visible then
                    visibleHeight = visibleHeight + child.Size.Y.Offset
                end
            end
            
            -- Add spacing between visible items
            local visibleCount = 0
            for _, child in pairs(container:GetChildren()) do
                if not child:IsA("UIListLayout") and child.Visible then
                    visibleCount = visibleCount + 1
                end
            end
            local spacing = math.max(0, visibleCount - 1) * 5  -- 5px spacing
            
            local height = 30 + visibleHeight + spacing + 20  -- 30 for title, 20 for padding
            section.Size = UDim2.new(1, 0, 0, height)
        end

        list:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateSectionSize)
        
        -- Initial size calculation
        updateSectionSize()

        local secObj = {}
        
        function secObj:CreateToggle(name)
            local toggleFrm = Instance.new("Frame", container)
            toggleFrm.Size = UDim2.new(1, -20, 0, 24)
            toggleFrm.Position = UDim2.new(0, 10, 0, 0)
            toggleFrm.BackgroundTransparency = 1
            
            local lbl = Instance.new("TextLabel", toggleFrm)
            lbl.Size = UDim2.new(1, -30, 1, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = name
            lbl.TextColor3 = Library.Theme.Text
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 13
            lbl.TextXAlignment = Enum.TextXAlignment.Left

            -- Square checkbox instead of sliding toggle
            local btn = Instance.new("TextButton", toggleFrm)
            btn.Size = UDim2.new(0, 18, 0, 18)
            btn.Position = UDim2.new(1, -18, 0.5, -9)
            btn.BackgroundColor3 = Color3.fromRGB(70, 75, 85) -- Grey when off
            btn.Text = ""
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 3)
            
            -- Border stroke
            local stroke = Instance.new("UIStroke", btn)
            stroke.Color = Color3.fromRGB(90, 95, 105)
            stroke.Thickness = 1

            -- Connect visibility change listener
            toggleFrm:GetPropertyChangedSignal("Visible"):Connect(updateSectionSize)

            local togmgr = { 
                State = false,
                Frame = toggleFrm,
                OnChanged = nil  -- Callback for when state changes
            }
            btn.MouseButton1Click:Connect(function()
                togmgr.State = not togmgr.State
                if togmgr.State then
                    -- Filled with yellow
                    btn.BackgroundColor3 = Library.Theme.Accent
                    stroke.Color = Library.Theme.Accent
                else
                    -- Grey when off
                    btn.BackgroundColor3 = Color3.fromRGB(70, 75, 85)
                    stroke.Color = Color3.fromRGB(90, 95, 105)
                end
                
                -- Fire callback if set
                if togmgr.OnChanged then
                    togmgr.OnChanged(togmgr.State)
                end
            end)
            return togmgr
        end

        function secObj:CreateSlider(name, min, max, default, startHidden)
            local sliderFrm = Instance.new("Frame", container)
            sliderFrm.Size = UDim2.new(1, -20, 0, 36)
            sliderFrm.Position = UDim2.new(0, 10, 0, 0)
            sliderFrm.BackgroundTransparency = 1
            sliderFrm.Visible = not startHidden  -- Hide initially if startHidden is true
            
            -- Connect visibility change listener
            sliderFrm:GetPropertyChangedSignal("Visible"):Connect(updateSectionSize)
            
            local lbl = Instance.new("TextLabel", sliderFrm)
            lbl.Size = UDim2.new(0.6, 0, 0, 16)
            lbl.BackgroundTransparency = 1
            lbl.Text = name
            lbl.TextColor3 = Library.Theme.Text
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 13
            lbl.TextXAlignment = Enum.TextXAlignment.Left

            local valLbl = Instance.new("TextLabel", sliderFrm)
            valLbl.Size = UDim2.new(0.4, 0, 0, 16)
            valLbl.Position = UDim2.new(0.6, 0, 0, 0)
            valLbl.BackgroundTransparency = 1
            valLbl.Text = tostring(default)
            valLbl.TextColor3 = Library.Theme.TextDark
            valLbl.Font = Enum.Font.Gotham
            valLbl.TextSize = 13
            valLbl.TextXAlignment = Enum.TextXAlignment.Right

            local track = Instance.new("TextButton", sliderFrm)
            track.Size = UDim2.new(1, 0, 0, 4)
            track.Position = UDim2.new(0, 0, 0, 24)
            track.BackgroundColor3 = Color3.fromRGB(40, 45, 60)
            track.Text = ""
            Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

            local fill = Instance.new("Frame", track)
            fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
            fill.BackgroundColor3 = Library.Theme.Accent
            Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
            
            local grab = Instance.new("Frame", fill)
            grab.Size = UDim2.new(0, 10, 0, 10)
            grab.Position = UDim2.new(1, -5, 0.5, -5)
            grab.BackgroundColor3 = Library.Theme.Accent
            Instance.new("UICorner", grab).CornerRadius = UDim.new(1, 0)

            local sldmgr = { 
                Value = default,
                Frame = sliderFrm
            }
            
            local dragging = false
            local function updateDrag(input)
                local mathHelper = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                sldmgr.Value = math.floor(min + ((max - min) * mathHelper))
                valLbl.Text = tostring(sldmgr.Value)
                fill.Size = UDim2.new(mathHelper, 0, 1, 0)
            end

            track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                    updateDrag(input)
                end
            end)
            
            local userInputService = game:GetService("UserInputService")
            userInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = false
                end
            end)
            userInputService.InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    updateDrag(input)
                end
            end)

            return sldmgr
        end

        function secObj:CreateDropdown(name, options)
            local dropFrm = Instance.new("Frame", container)
            dropFrm.Size = UDim2.new(1, -20, 0, 24)
            dropFrm.Position = UDim2.new(0, 10, 0, 0)
            dropFrm.BackgroundTransparency = 1
            
