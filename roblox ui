local function toggleMenuPanel()
    if not menuPanel then
        initMenuPanel()
    end

    isMenuOpen = not isMenuOpen

    if isMenuOpen then
        -- Show menu, hide game UI
        menuPanel.Visible = true
        modalBlocker.Visible = true
        
        local tb = getTopBar()
        if tb then tb.Size = UDim2.new(2, tb.Size.X.Offset, tb.Size.Y.Scale, tb.Size.Y.Offset) end
        
        local body = getBody()
        if body then body.Visible = false end
        
        local btnCont = getButtonContainer()
        if btnCont then btnCont.Visible = false end
    else
        -- Hide menu, show game UI
        menuPanel.Visible = false
        modalBlocker.Visible = false
        
        local tb = getTopBar()
        if tb then tb.Size = UDim2.new(1, tb.Size.X.Offset, tb.Size.Y.Scale, tb.Size.Y.Offset) end
        
        local body = getBody()
        if body then body.Visible = true end
        
        local btnCont = getButtonContainer()
        if btnCont then btnCont.Visible = true end
    end
end

