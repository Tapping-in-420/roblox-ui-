        -- This keeps the circle growing smoothly across the full slider range
        local minValue, maxValue = 50, 360
        local minDisplay, maxDisplay = 50, 160
        local displaySize = minDisplay + ((value - minValue) / (maxValue - minValue)) * (maxDisplay - minDisplay)
        displaySize = math.clamp(displaySize, minDisplay, maxDisplay)
        
        fovPreview.Circle.Size = UDim2.new(0, displaySize, 0, displaySize)
        fovPreview.Circle.Position = UDim2.new(0.5, -displaySize/2, 0.5, -displaySize/2)
    end
    
