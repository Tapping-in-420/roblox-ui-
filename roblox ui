            lbl.BackgroundTransparency = 1
            lbl.Text = name
            lbl.TextColor3 = Library.Theme.Text
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 13
            lbl.TextXAlignment = Enum.TextXAlignment.Left

            local btn = Instance.new("TextButton", dropFrm)
            btn.Size = UDim2.new(0.5, 0, 0, 20)
            btn.Position = UDim2.new(0.5, 0, 0.5, -10)
            btn.BackgroundColor3 = Color3.fromRGB(20, 24, 34)
            btn.Text = options[1] or "Select"
            btn.TextColor3 = Library.Theme.TextDark
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 12
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
            local btnStroke = Instance.new("UIStroke", btn)
            btnStroke.Color = Color3.fromRGB(40, 45, 60)
            btnStroke.Thickness = 1

            local drpmgr = { Value = options[1] }
            
