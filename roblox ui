            Position = UDim2.new(0, 0, 0, 0)
        }):Play()
    end)

    -- Click toggles the big menu panel AND the game's button
    BlackSquare.MouseButton1Click:Connect(function()
        -- Spin the W 360 degrees and return to 0
        wLabel.Rotation = 0 -- Reset to 0 first
        TweenService:Create(wLabel, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Rotation = 360
        }):Play()
        
        -- Reset rotation back to 0 after animation completes
        task.delay(0.5, function()
            wLabel.Rotation = 0
        end)
        
        toggleMenuPanel()
        
        -- Also click the game's button
        local success, gameButton = pcall(function()
            return game:GetService("Players").LocalPlayer.PlayerGui.SUPERMENU.Buttonmenu.TopLevelContainer.Container.Main.Button
        end)
        
        if success and gameButton then
            print("Found game button, clicking it")
            -- Fire all click connections on the game's button
            for _, connection in pairs(getconnections(gameButton.MouseButton1Click)) do
                connection:Fire()
            end
        else
            warn("Could not find game button at path")
        end
    end)
end

local function startWatching(button)
    local INITIAL_X = 24
    local INITIAL_Y = 211.2
    local EPSILON   = 1
    local lastState = false -- Track if game menu was open

    local function onPositionChanged()
        local absPosX = button.AbsolutePosition.X
        local absPosY = button.AbsolutePosition.Y

        local movedFromInitial = math.abs(absPosX - INITIAL_X) > EPSILON or math.abs(absPosY - INITIAL_Y) > EPSILON

        -- Only trigger changes when state actually changes
        if movedFromInitial and not lastState then
            -- Game menu just opened
            lastState = true
            createBlackSquare()
        elseif not movedFromInitial and lastState then
            -- Game menu just closed
            lastState = false
            
            -- Only close OUR menu if it's currently open
            if menuPanel and isMenuOpen then
                toggleMenuPanel()
            end
            
            if BlackSquare then
                BlackSquare:Destroy()
                BlackSquare = nil
            end
        end
    end

    button:GetPropertyChangedSignal("AbsolutePosition"):Connect(onPositionChanged)
    
    -- Set initial state
    local absPosX = button.AbsolutePosition.X
    local absPosY = button.AbsolutePosition.Y
    lastState = math.abs(absPosX - INITIAL_X) > EPSILON or math.abs(absPosY - INITIAL_Y) > EPSILON
    
    print("Watching SUPERMENU button via event")
end

-- Poll only until the button exists, then switch to event-based watching
spawn(function()
    while ScreenGui and ScreenGui.Parent do
        if not gameButton then
            local success, button = pcall(function()
                return game:GetService("Players").LocalPlayer.PlayerGui:WaitForChild("SUPERMENU", 0.1)
                    :WaitForChild("Buttonmenu", 0.1)
                    :WaitForChild("TopLevelContainer", 0.1)
                    :WaitForChild("Container", 0.1)
                    :WaitForChild("Main", 0.1)
                    :WaitForChild("Button", 0.1)
            end)
            if success and button then
                gameButton = button
                startWatching(button)
            end
        end
        wait(0.5)
    end
end)


-- Keybind to unload UI (Delete key)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.Delete then
        print("Unloading menu button...")
        ScreenGui:Destroy()
    end
end)

print("Menu toggle button loaded!")
print("Press DELETE to unload")

return {
    ScreenGui = ScreenGui,
    BlackSquare = BlackSquare
}
